load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "forecast",
    srcs = ["dates.py"],
    deps = ["@pypi//python_dateutil"],
)

py_test(
    name = "dates_test",
    srcs = [
