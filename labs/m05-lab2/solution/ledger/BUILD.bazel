load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "ledger",
    srcs = ["ledger.py"],
)

py_test(
    name = "ledger_test",
    size = "small",
    srcs = ["ledger_test.py"],
    data = ["testdata/entries.json"],
    deps = [
        ":ledger",
        "@rules_python//python/runfiles",
    ],
)

py_test(
    name = "smoke_test",
    srcs = ["smoke_test.py"],
    tags = [
        "external",
        "manual",
    ],
)

test_suite(
    name = "integration",
    tags = ["manual"],
    tests = [":smoke_test"],
)
