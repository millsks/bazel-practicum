# A constraint the standard @platforms module does not know about: does the machine have a GPU?
constraint_setting(
    name = "accelerator",
    default_constraint_value = ":cpu_only",
)

constraint_value(
    name = "cpu_only",
    constraint_setting = ":accelerator",
    visibility = ["//visibility:public"],
)

constraint_value(
    name = "gpu",
    constraint_setting = ":accelerator",
    visibility = ["//visibility:public"],
)

# Add a platform named "gpu_host" here: this machine's platform plus the :gpu constraint.
